{
  "name": "neodirect-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The studio: a browser front end and an MCP server over one core.",
  "scripts": {
    "dev": "vite --config web/vite.config.js",
    "start": "node open.mjs",
    "build": "vite build --config web/vite.config.js",
    "serve": "node server.mjs",
    "mcp": "node mcp.mjs",
    "test": "node --test 'test/**/*.test.mjs'",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "desktop-entry": "node desktop-entry.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "zustand": "^5.0.0"
  }
}
